@PACKAGE_INIT@
include(CMakeFindDependencyMacro)

# The exported VANTAGE::Reactions target links MPI and NESO-Particles
# transitively, so consumers need those packages found at configure time.
# SYCL is pulled in via NESO-Particles' own CMake config (it exports the
# add_sycl_to_target macro / runtime target), so no separate find_dependency
# is required here.
find_dependency(MPI)
find_dependency(NESO-Particles)

include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@Targets.cmake")
